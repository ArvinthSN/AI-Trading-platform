DATABASE_URL=

# Binance public market data endpoints (public data does not require API credentials).
BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443
BINANCE_REQUEST_TIMEOUT_SECONDS=10
# Optional account integration: create a Binance API key with Spot read-only permission only.
# Never enable trading or withdrawal permissions. Keep these values in deployment secrets.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_RECV_WINDOW_MS=5000

COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
FEAR_GREED_API_URL=https://api.alternative.me/fng/
TRADING_ECONOMICS_API_KEY=
TRADING_ECONOMICS_API_BASE_URL=https://api.tradingeconomics.com

NEWS_RSS_URL=
REGULATORY_RSS_URL=
GEOPOLITICAL_RSS_URL=
GLOBAL_REGIONS_API_URL=
GLOBAL_EVENTS_API_URL=
GEOPOLITICAL_EVENTS_API_URL=

OPENAI_API_KEY=
OPENAI_MODEL=
PAPER_TRADING_ENGINE_URL=
PAPER_TRADING_ENGINE_TOKEN=

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_REST_BASE_URL=https://api.kraken.com
KRAKEN_WS_BASE_URL=wss://ws.kraken.com

COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_REST_BASE_URL=https://api.exchange.coinbase.com
COINBASE_WS_BASE_URL=wss://ws-feed.exchange.coinbase.com

MARKET_PRIMARY_PROVIDER=binance
MARKET_SECONDARY_PROVIDER=kraken
MARKET_GLOBAL_PROVIDER=coingecko
MARKET_WEBSOCKET_ENABLED=true
MARKET_CACHE_ENABLED=true
